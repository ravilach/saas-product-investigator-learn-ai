# Copy to deploy/.env and fill in. deploy/.env is gitignored; this file is not.
#
#   cp deploy/.env.example deploy/.env
#   printf 'CREDENTIAL_ENCRYPTION_KEY=%s\n' "$(head -c 32 /dev/urandom | base64)" >> deploy/.env
#
# Read by `docker compose -f deploy/docker-compose.yml up` automatically, and usable
# for a plain `mvn spring-boot:run` with:  set -a; . deploy/.env; set +a

# The master key for everything encrypted at rest: LLM API keys, MCP authTokens, and the
# auto-generated JWT signing secret. Generate with: head -c 32 /dev/urandom | base64
# Keep it stable across restarts — change it and every stored secret becomes unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# Where MongoDB lives. Use localhost for `mvn spring-boot:run`, the service name for compose.
MONGODB_URI=mongodb://localhost:27017/saas-investigator

# Optional. Both can also be set after boot from Admin Console -> Secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JWT_SECRET is deliberately absent: left unset, the app generates one on first boot and
# persists it encrypted, so restarts do not sign everyone out. Set it only when several
# replicas must share one signing key.
