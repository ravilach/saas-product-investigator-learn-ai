# Copy to deploy/.env and fill in. That file is gitignored; this one is committed.
#
#   cp deploy/.env.example deploy/.env
#   printf 'CREDENTIAL_ENCRYPTION_KEY=%s\n' "$(head -c 32 /dev/urandom | base64)" >> deploy/.env
#
# Two consumers, and they read it differently:
#
#   docker compose -f deploy/docker-compose.yml up     # reads deploy/.env automatically
#   set -a; . deploy/.env; set +a; cd backend && mvn spring-boot:run
#                                                      # -a exports each assignment so the JVM inherits it
#
# Every variable here is optional to the application (see docs/SETUP.md) with one
# exception noted below. This file exists so the values that must stay *stable*
# between runs live somewhere other than your shell history.

# ---------------------------------------------------------------------------
# The one you have to set
# ---------------------------------------------------------------------------
# Master key for everything encrypted at rest: LLM API keys, MCP auth tokens, the
# persisted JWT signing secret. Generate with `head -c 32 /dev/urandom | base64`.
#
# Change it and every value already encrypted under the old one becomes
# permanently unreadable - silently, because undecryptable values are treated as
# unset rather than raising. That is the whole reason this is a file and not a
# `$(head -c 32 ...)` inside your run command.
#
# Outside Docker the app refuses to start without it. docker-compose.yml also
# requires it explicitly (`:?`) rather than letting the container generate one,
# because a compose stack with a real named Mongo volume outliving a generated
# key is exactly the mismatch that loses data.
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset for local `mvn spring-boot:run` - application.properties already
# defaults to mongodb://localhost:27017/saas-investigator, which is where
# `docker compose up -d mongo` publishes. docker-compose.yml sets its own value
# for the app service (mongodb://mongo:27017/...) and ignores anything here.
#MONGODB_URI=mongodb://localhost:27017/saas-investigator

# ---------------------------------------------------------------------------
# LLM providers - optional, and not the only way in
# ---------------------------------------------------------------------------
# A key set here applies to everyone's runs. You can equally add one from
# Admin Console -> Secrets after boot (which outranks this), or per-user in
# Account Settings. See docs/SETUP.md, "Where an LLM API key can live".
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Model names move faster than this repo does; these are the shipped defaults.
#ANTHROPIC_MODEL=claude-sonnet-5
#OPENAI_MODEL=gpt-6-astra

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Deliberately commented out. Unset, the app generates a 256-bit secret on first
# boot and persists it encrypted, so restarts do NOT sign everyone out. Setting
# it here signs out every active session the next time the app starts.
#JWT_SECRET=
#JWT_EXPIRATION_HOURS=12

# ---------------------------------------------------------------------------
# Rarely needed locally
# ---------------------------------------------------------------------------
#SERVER_PORT=8080
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#IGNORE_HOST_CREDENTIALS=false
#RUN_CONCURRENCY=3
#RUN_QUEUE_CAPACITY=12
#ASK_CONCURRENCY=6
#LLM_MAX_PROMPT_CHARS=600000
