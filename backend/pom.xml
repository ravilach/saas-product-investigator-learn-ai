<?xml version="1.0" encoding="UTF-8"?>
<!--
  SaaS Product Investigator - backend build.

  Two things in here are deliberate and easy to "fix" into breakage:

  1. <release>25</release> rather than a <source>/<target> pair. Java 25 is the
     current LTS; using `release` also checks that we only call APIs that exist
     in 25, so building on a newer JDK (26, 27...) still produces a jar that
     genuinely runs on the temurin:25-jre image the Dockerfile ships.
  2. JaCoCo is bound to `test`, never to `package`. The Dockerfile builds with
     -DskipTests on purpose (see /docs/SETUP.md) so a red or half-written test
     suite can never be the reason `docker run` fails to boot the app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.saasinvestigator</groupId>
  <artifactId>saas-product-investigator</artifactId>
  <version>0.1.0</version>
  <name>saas-product-investigator</name>
  <description>Multi-user tool that uses an LLM to detect and report what changed in a SaaS product</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <springdoc.version>3.1.1</springdoc.version>
    <jjwt.version>0.13.0</jjwt.version>
    <jsoup.version>1.23.2</jsoup.version>
    <anthropic.version>2.64.0</anthropic.version>
    <openai.version>4.65.0</openai.version>
    <openhtmltopdf.version>1.1.86</openhtmltopdf.version>
    <poi.version>5.5.1</poi.version>
    <!--
      0.8.15, not 0.8.13: the agent instruments every class the test JVM loads,
      including JDK internals, and 0.8.13 aborts on class file major version 70
      (Java 26) with a screenful of "Error while instrumenting jdk/..." noise on
      any developer machine running a JDK newer than the 25 we target.
    -->
    <jacoco.version>0.8.15</jacoco.version>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <!--
    Spring Boot 4.1's parent no longer pins Testcontainers versions, so import
    its BOM ourselves rather than version each module by hand.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ===== Web / data / security ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ===== Observability: Actuator + Prometheus scrape endpoint ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- ===== Live API docs at /swagger-ui.html ===== -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ===== JWT (stateless auth) ===== -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- ===== Crawler: HTML parsing / visible-text extraction ===== -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>

    <!-- ===== LLM providers (both server-side only) ===== -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic.version}</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${openai.version}</version>
    </dependency>

    <!-- ===== Report export: PDF from styled HTML, DOCX built directly ===== -->
    <dependency>
      <groupId>io.github.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
      <version>${openhtmltopdf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- ===== Tests ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure
      into per-technology modules, and spring-boot-starter-test no longer pulls
      them in. @WebMvcTest lives in spring-boot-webmvc-test and @DataMongoTest in
      spring-boot-data-mongodb-test; without these two, both annotations simply
      do not exist on the test classpath.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-mongodb-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        JaCoCo: bound to `test` only, producing target/site/jacoco/index.html.
        No `check` goal / coverage threshold yet - deliberately deferred, not
        forgotten (see the `enable-coverage-gate` skill for turning one on).
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
